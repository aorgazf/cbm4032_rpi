	(text "Bus transceiver SN75161B and Pi-side level translators. 10k pull-ups hold every 5 V terminal line high; A-side pull-ups (R5-R7) and series resistors (R32/R33) sit on the Pi GPIO lines."
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "1b5e3144-44ca-427b-a146-7f02c4f929cc")
	)
	(text "R3 4.7k holds the gated CTRL_TE low whenever U20 is unpowered (SN75161B TE IIL up to -100 uA)."
		(exclude_from_sim no)
		(at 30.48 340.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2d874a2f-40ba-4c73-8fec-07b7cc58dcad")
	)
	(text "REV03B ATN RESPONSE (approved): DC strapped high by R11 (U16/U13/U17/U19/U12/U14 removed)."
		(exclude_from_sim no)
		(at 30.48 330.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3132a8ec-4888-47ee-9ef3-0f89ab76655f")
	)
	(text "U23 holds bus NDAC low from ATN assertion until firmware sets ATNA (GPIO16) = ATN level; idle ATNA = H (R30)."
		(exclude_from_sim no)
		(at 30.48 345.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "510a295f-d708-4115-b803-1112f8a6248a")
	)
	(text "Direction control logic"
		(exclude_from_sim no)
		(at 431.8 40.64 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "63607297-e812-4dff-8534-fcba58921e16")
	)
	(text "R32-R41 limit current when hardware reverses a translator that the Pi is still driving (R34-R41 on the data-bus sheet)."
		(exclude_from_sim no)
		(at 30.48 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a0b2376f-b2b4-4e2e-859c-845100c281c2")
	)
	(text "CTRL_TE and DATA_TE are forced low while ATN is asserted (GPIO27 low): talker/data drivers release in hardware."
		(exclude_from_sim no)
		(at 30.48 335.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ac4b2ca1-482a-4218-86a1-4803d99a7a64")
