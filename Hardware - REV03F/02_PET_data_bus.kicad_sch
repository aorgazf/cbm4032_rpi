	(text "REV03A: R20-R27 pull D1_5V..D8_5V to 5V_HAT. SN75160B terminal VOH min 2.7 V < SN74LVC8T245 B-port VIH 0.7xVCCB (3.5 V)."
		(exclude_from_sim no)
		(at 55.88 210.82 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "570ede3a-2d13-40e2-a825-708fe53ee875")
	)
	(text "R34-R41 (and R32/R33 on the handshake sheet) limit current when hardware reverses a translator that the Pi is still driving."
		(exclude_from_sim no)
		(at 30.48 214.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "76b3dcd6-7b1e-42ed-9e7f-8d42cec737ab")
	)
	(text "REV03A: U1 pin 11 is PE (pull-up enable). Tied to GND = passive-pullup (open-collector) DIO drivers. R1 now 4.7k: TE IIL up to -100 uA."
		(exclude_from_sim no)
		(at 55.88 205.74 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e7083ffe-f197-4aad-9b40-80f0ded620ad")
	)
